{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scooter-india",
  "compatibility_date": "2026-09-10",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
